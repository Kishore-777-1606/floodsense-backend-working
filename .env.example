# FloodSense Backend Environment Configuration

# MongoDB Connection String:
# Local instance (default):
MONGODB_URI=mongodb://localhost:27017/floodsense

# For MongoDB Atlas (Free-tier cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/floodsense?retryWrites=true&w=majority

# Database Name
MONGODB_DB_NAME=floodsense

# Server Port
PORT=5000
